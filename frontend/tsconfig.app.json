{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Vite handles emit, so tsc only type-checks. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Incremental migration: the existing .jsx files still compile. They are
       not type-checked (checkJs is off), so they neither block the build nor
       lose their behaviour while being rewritten in TypeScript. */
    "allowJs": true,
    "checkJs": false,

    /* Strictness for all new code. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitOverride": true,
    /* Forces index access to be narrowed before use, which is what catches the
       "undefined is not an object" class of runtime error at compile time. */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* Path aliases — kept in sync with vite.config.ts. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
