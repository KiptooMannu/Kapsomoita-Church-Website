# ===========================================================================
# Frontend environment template.
# Copy to frontend/.env and fill in real values. NEVER commit frontend/.env.
#   cp frontend/.env.example frontend/.env
#
# WARNING: every VITE_* variable is inlined into the public JS bundle at build
# time and is visible to anyone who opens the site. Only put PUBLIC values
# here. Secrets (M-Pesa consumer secret, passkey, DB password, JWT secrets)
# belong in backend/.env and must never appear in this file.
# ===========================================================================

# Base URL of the Spring Boot API.
VITE_API_URL=http://localhost:8080/api

# Set true only for GitHub Pages builds (controls Vite's `base` path).
VITE_GITHUB_PAGES=false

# --- Public keys (safe to expose; restrict them by HTTP referrer) --------
VITE_GOOGLE_MAPS_API_KEY=
# Cloudinary cloud name. Delivery-only, so safe to expose. The API key and
# secret belong in backend/.env and must NEVER appear here.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_PAYPAL_CLIENT_ID=
